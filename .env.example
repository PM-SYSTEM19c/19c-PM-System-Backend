NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_management

# SECURITY: Generate a strong secret in production: `openssl rand -base64 48`
JWT_SECRET=supersecretkey-change-this-in-production-min32chars
JWT_EXPIRES_IN=7d

# Comma-separated allowed origins (e.g., https://your-production-app.vercel.app)
CORS_ORIGIN=http://localhost:3001

# Same server-only secret as Vercel; verifies signed visitor IP, not user authentication.
# API_PROXY_SECRET=<generate-a-new-random-secret-minimum-32-characters>

# Recommended fixed Railway API origin for upload links (without /api/v1).
# PUBLIC_URL=https://your-backend.up.railway.app

# Standup scheduler (on | off). Set to off in multi-instance worker setups
STANDUP_SCHEDULER=on
